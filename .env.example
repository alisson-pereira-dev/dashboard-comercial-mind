# GoHighLevel (somente servidor, nunca usar prefixo NEXT_PUBLIC_)
GHL_TOKEN=
GHL_LOCATION_ID=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor (usada pelo sync para gravar)
SUPABASE_SERVICE_ROLE_KEY=

# Nome exibido no topo do dashboard
NEXT_PUBLIC_CLINIC_NAME=

# Ids de usuario do GHL que sao vendedores, separados por virgula.
# O primeiro e o padrao para registros sem responsavel no GHL.
GHL_VENDEDORES_IDS=

# Opcional. Nome EXATO do pipeline em que o funil e medido (leads, qualificados e vendas).
# Padrao: Qualificação ( IA )
GHL_PIPELINE_FUNIL=
